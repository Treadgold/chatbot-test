# Use NVIDIA CUDA base image
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.ai/install.sh | sh

# Install Python dependencies for the handler
RUN pip3 install requests runpod

# Create working directory
WORKDIR /app

# Copy handler script and scripts
COPY ollama_handler.py .
COPY test_input.json .
COPY scripts/download_model.sh /tmp/download_model.sh
COPY scripts/start.sh /tmp/start.sh

# Make scripts executable
RUN chmod +x /tmp/download_model.sh /tmp/start.sh

# Download model during build
RUN ollama serve & \
    OLLAMA_PID=$! && \
    echo "Started Ollama service with PID: $OLLAMA_PID" && \
    until ollama list >/dev/null 2>&1; do \
        echo "Waiting for Ollama service to start..." && \
        sleep 2; \
    done && \
    echo "Ollama service is ready, downloading model..." && \
    /tmp/download_model.sh && \
    echo "Model download completed" && \
    kill $OLLAMA_PID && \
    wait $OLLAMA_PID 2>/dev/null || true && \
    echo "Ollama service stopped"
    

# Set the startup script
CMD ["/tmp/start.sh"] 