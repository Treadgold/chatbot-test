# Use official Ollama image as base
FROM ollama/ollama:latest

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV OLLAMA_HOST=0.0.0.0
ENV OLLAMA_ORIGINS=*
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Install Python and basic dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install --break-system-packages requests runpod

# Create working directory
WORKDIR /app

# Copy handler script and test input
COPY ollama_handler.py .
COPY test_input.json .

# Create the Ollama directory structure
RUN mkdir -p /root/.ollama/models

# Copy local models to the correct Ollama directory structure
# This preserves the manifests/ and blobs/ structure
COPY models/ /root/.ollama/models/

# Set proper permissions for Ollama to access the models
RUN chown -R root:root /root/.ollama && \
    chmod -R 755 /root/.ollama && \
    find /root/.ollama -type f -exec chmod 644 {} \;

# Create a simple startup script
COPY start.sh /tmp/start.sh
RUN chmod +x /tmp/start.sh

# Expose Ollama port
EXPOSE 11434

# Override the entrypoint and use our startup script
ENTRYPOINT []
CMD ["/tmp/start.sh"] 