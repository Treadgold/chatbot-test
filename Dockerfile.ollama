# Use official Ollama image as base
FROM ollama/ollama:latest

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV OLLAMA_HOST=0.0.0.0
ENV OLLAMA_ORIGINS=*

# Install Python and basic dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages
RUN pip3 install requests runpod

# Create working directory
WORKDIR /app

# Copy handler script
COPY ollama_handler.py .

# Create a simple startup script
RUN echo '#!/bin/bash\n\
echo "Starting Ollama..."\n\
ollama serve &\n\
sleep 10\n\
echo "Starting Python handler..."\n\
python3 -u ollama_handler.py' > /tmp/start.sh && chmod +x /tmp/start.sh

# Expose Ollama port
EXPOSE 11434

# Use the simple startup script
CMD ["/tmp/start.sh"] 