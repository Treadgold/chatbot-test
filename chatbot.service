[Unit]
Description=Chatbot ASGI Application
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/chatbot-test
Environment=PATH=/home/ubuntu/chatbot-test/.venv310/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/ubuntu/chatbot-test
ExecStart=/home/ubuntu/chatbot-test/.venv310/bin/python -m uvicorn asgi:application --host 0.0.0.0 --port 8000 --workers 1
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chatbot

# Security settings (relaxed for debugging)
NoNewPrivileges=true

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target 